# Copy to .env (git-ignored) and fill in. Never commit .env.
# Personal access token created in Figma: Settings > Security > Personal access tokens.
# Give it the minimum scopes you need.
FIGMA_ACCESS_TOKEN=

# Keep the WebSocket on localhost. Do not set 0.0.0.0.
# FIGMA_WS_HOST=localhost

# Herramientas que publica el servidor (menos herramientas = menos tokens por conversacion).
# esencial (13, ~6k tokens) | diseno (32, ~12k) | todo (130, ~54k) | lista: esencial,figma_get_comments
# SONDA_TOOLS=esencial
